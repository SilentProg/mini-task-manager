{
  "name": "mini-task-manager",
  "version": "1.0.0",
  "description": "**Mini Task Manager** — це базовий веб-додаток для керування списком повсякденних завдань. Проєкт створено з метою демонстрації навичок роботи з розподіленою системою контролю версій Git та платформою GitHub у рамках виконання лабораторної роботи.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "cd client && npm install && npm run build",
    "dev:client": "cd client && npm run dev",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "pretest:ci": "node -e \"require('fs').mkdirSync('reports', { recursive: true })\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml \"test/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilentProg/mini-task-manager.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SilentProg/mini-task-manager/issues"
  },
  "homepage": "https://github.com/SilentProg/mini-task-manager#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  }
}
