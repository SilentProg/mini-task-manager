# Скопіюйте у .env і змініть паролі: cp .env.example .env
# Docker Compose читає цей файл автоматично.

# Версія (тег) образу застосунку. Змініть, щоб зібрати й розгорнути нову версію.
APP_VERSION=1.0

# Порт на хості, на якому nginx роздає застосунок
NGINX_PORT=8088

# Кількість екземплярів застосунку за nginx
APP_REPLICAS=2

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=mini_task_manager
DB_USER=mtm
DB_PASSWORD=change_me_app

# Секрет для підпису JWT (будь-який довгий випадковий рядок)
JWT_SECRET=change_me_jwt_secret

# Ваш логін Docker Hub (для docker push)
DOCKERHUB_USER=silentprog
